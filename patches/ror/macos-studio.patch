+/// RobloxStudio.app (`open -a` launches it with a place).
+#[cfg(target_os = "macos")]
+pub fn studio_executable() -> Option<std::path::PathBuf> {
+	let home = std::env::var_os("HOME").map(std::path::PathBuf::from);
+	[Some(std::path::PathBuf::from("/Applications/RobloxStudio.app")), home.map(|home| home.join("Applications").join("RobloxStudio.app"))]
+		.into_iter()
+		.flatten()
+		.find(|path| path.is_dir())
+}
